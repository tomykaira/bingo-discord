{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bingo-discord",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "heki-bingo",
			"database_id": "fcfe300c-618a-46e3-9bb2-9de24852b95d",
			"migrations_dir": "migrations"
		}
	]
	// シークレット DISCORD_PUBLIC_KEY は `npx wrangler secret put DISCORD_PUBLIC_KEY` で設定する
}
